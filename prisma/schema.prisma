generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String   @id @default(cuid())
  name                  String?
  email                 String   @unique
  password              String?
  logoUrl               String?
  primaryColor          String?
  fontFamily            String?
  brandingSyncWithTheme Boolean  @default(false)
  useThemeForPdf        Boolean  @default(false)
  themePrimary          String?  @default("#6366F1")
  themeAccent           String?  @default("#22D3EE")
  themeMode             String?  @default("dark")
  defaultCurrency       String   @default("IDR")
  locale                String   @default("en")
  /// Server-side hint only; access is always revalidated through Membership.
  activeOrganizationId  String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  invoices         Invoice[]
  auditLogs        AuditLog[]
  clients          Client[]
  invoiceTemplates InvoiceTemplate[]
  memberships      Membership[]
  sentInvitations  WorkspaceInvitation[] @relation("WorkspaceInvitationInviter")
  createdApiKeys   ApiKey[] @relation("ApiKeyCreator")
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model Organization {
  id              String   @id @default(cuid())
  name            String
  logoUrl         String?
  primaryColor    String?
  fontFamily      String?
  defaultCurrency String   @default("IDR")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  memberships           Membership[]
  invoices              Invoice[]
  clients               Client[]
  invoiceTemplates      InvoiceTemplate[]
  invitations           WorkspaceInvitation[]
  notificationEndpoints WorkspaceNotificationEndpoint[]
  reminderRules         InvoiceReminderRule[]
  reminderOccurrences   InvoiceReminderOccurrence[]
  apiKeys               ApiKey[]

  @@index([createdAt])
}

model Membership {
  id             String        @id @default(cuid())
  organizationId String
  userId         String
  role           WorkspaceRole @default(MEMBER)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId, role])
}

model ApiKey {
  id             String   @id @default(cuid())
  organizationId String
  createdById    String
  name           String
  prefix         String
  secretHash     String
  scopes         String[]
  expiresAt      DateTime?
  revokedAt      DateTime?
  lastUsedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("ApiKeyCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@unique([prefix], map: "api_key_prefix")
  @@index([organizationId, revokedAt])
  @@index([organizationId, createdAt])
}

model WorkspaceInvitation {
  id             String        @id @default(cuid())
  organizationId String
  email          String
  role           WorkspaceRole @default(MEMBER)
  tokenHash      String        @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  invitedById    String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("WorkspaceInvitationInviter", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([organizationId, email])
  @@index([organizationId, expiresAt])
}

model WorkspaceNotificationEndpoint {
  id               String   @id @default(cuid())
  organizationId   String
  type             String
  secretCiphertext String
  enabled          Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, type])
  @@index([organizationId, enabled])
}

model InvoiceReminderRule {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  offsetDays     Int
  channels       Json
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  occurrences  InvoiceReminderOccurrence[]

  @@index([organizationId, enabled])
}

model InvoiceReminderOccurrence {
  id             String    @id @default(cuid())
  organizationId String
  invoiceId      String
  ruleId         String
  occurrenceKey  String    @unique
  scheduledAt    DateTime
  status         String    @default("PENDING")
  attempts       Int       @default(0)
  sentAt         DateTime?
  providerRef    String?
  error          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice      Invoice             @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  rule         InvoiceReminderRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  deliveries   InvoiceReminderDelivery[]

  @@index([organizationId, scheduledAt, status])
  @@index([invoiceId, ruleId])
}

enum InvoiceReminderDeliveryStatus {
  PENDING
  PROCESSING
  RETRY
  SENT
  FAILED
  SKIPPED
}

model InvoiceReminderDelivery {
  id            String                         @id @default(cuid())
  occurrenceId  String
  channel       String
  status        InvoiceReminderDeliveryStatus  @default(PENDING)
  attempts      Int                            @default(0)
  nextAttemptAt DateTime?
  claimedAt     DateTime?
  sentAt        DateTime?
  providerRef   String?
  errorCode     String?
  errorMessage  String?
  createdAt     DateTime                       @default(now())
  updatedAt     DateTime                       @updatedAt

  occurrence InvoiceReminderOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)

  @@unique([occurrenceId, channel], map: "invoice_reminder_delivery_occurrence_channel")
  @@index([status, nextAttemptAt])
  @@index([occurrenceId, status])
}

model Invoice {
  id        String        @id @default(cuid())
  number    String
  client    String
  items     Json
  subtotal  Int
  tax       Int
  total     Int
  status    InvoiceStatus @default(DRAFT)
  issuedAt  DateTime
  dueAt     DateTime?
  paidAt    DateTime?
  emailedAt DateTime?
  emailLog  Json?
  notes     String?
  currency  String        @default("IDR")

  userId         String
  user           User          @relation(fields: [userId], references: [id])
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  clientId       String?
  client_rel     Client?       @relation(fields: [clientId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments            Payment[]
  paymentAttempts     PaymentAttempt[]
  reminderOccurrences InvoiceReminderOccurrence[]

  @@unique([organizationId, number], map: "invoice_organization_number")
  @@index([organizationId, createdAt])
  @@index([clientId])
  @@index([organizationId, status, createdAt])
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  UNPAID
  OVERDUE
}

model OptimizationLog {
  id             String             @id @default(cuid())
  route          String
  change         String
  impact         String
  confidence     Float              @default(0.7)
  status         OptimizationStatus @default(PENDING)
  actor          String             @default("system")
  notes          String?
  rollback       Boolean            @default(false)
  deltaImpact    Float              @default(0)
  evalConfidence Float              @default(0.7)
  policyStatus   PolicyStatus       @default(ALLOWED)
  policyReason   String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  explanations ExplanationLog[]
}

enum OptimizationStatus {
  PENDING
  APPLIED
  REJECTED
}

model ExplanationLog {
  id               String       @id @default(cuid())
  recommendationId String
  route            String
  why              String
  context          String?
  dataBasis        Json
  confidence       Float
  policyStatus     PolicyStatus @default(ALLOWED)
  trustScore       Float        @default(0)
  actor            String       @default("system")
  createdAt        DateTime     @default(now())
  metadata         Json?

  recommendation OptimizationLog @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
}

enum PolicyStatus {
  ALLOWED
  REVIEW
  BLOCKED
}

model LearningProfile {
  route             String    @id
  successRate       Float     @default(0)
  avgImpact         Float     @default(0)
  confidenceWeight  Float     @default(0.7)
  totalEvaluations  Int       @default(0)
  lastLcpP95        Float     @default(0)
  lastInpP95        Float     @default(0)
  lastApiLatencyP95 Float     @default(0)
  lastErrorRate     Float     @default(0)
  lastEval          DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model AgentEventLog {
  id               String   @id @default(cuid())
  traceId          String
  eventType        String
  sourceAgent      String
  targetAgent      String?
  priority         Int
  summary          String
  payload          Json
  recommendationId String?
  createdAt        DateTime @default(now())

  @@index([traceId])
  @@index([recommendationId])
}

model AgentPriority {
  id         String   @id @default(cuid())
  agent      String
  weight     Float
  confidence Float    @default(0.5)
  rationale  String?
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([agent])
  @@index([agent])
}

model RecoveryLog {
  id               String   @id @default(cuid())
  agent            String
  action           String
  reason           String?
  traceId          String?
  trustScoreBefore Float?
  trustScoreAfter  Float?
  metadata         Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([agent])
  @@index([createdAt])
}

model FederationMetrics {
  id                   String   @id @default(cuid())
  cycleId              String
  tenantId             String
  participants         Int
  averageTrust         Float
  medianTrust          Float
  trustStdDeviation    Float
  highestTenant        String?
  highestTrust         Float?
  lowestTenant         String?
  lowestTrust          Float?
  averageLatencyMs     Float?
  aggregatedPriorities Json
  summary              String?
  networkHealth        String   @default("healthy")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([cycleId, tenantId])
}

enum ExperimentAxis {
  HOOK
  CAPTION
  CTA
  SCHEDULE
}

enum ExperimentStatus {
  running
  paused
  stopped
  completed
}

enum AutoActionType {
  AUTOPUBLISH
  SCHEDULE_UPDATE
  AUTO_REVERT
  AUTO_CTA_TUNE
}

enum AutoActionStatus {
  applied
  reverted
  failed
}

model ContentExperiment {
  id              Int              @id @default(autoincrement())
  organizationId  String?
  contentId       Int
  axis            ExperimentAxis
  status          ExperimentStatus @default(running)
  startAt         DateTime         @default(now())
  endAt           DateTime?
  winnerVariantId Int?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  variants      ContentVariant[]
  winnerVariant ContentVariant?  @relation("ExperimentWinner", fields: [winnerVariantId], references: [id])
  autoActions   AiAutoAction[]   @relation("ExperimentAutoActions")

  @@index([organizationId, contentId, axis])
}

model ContentVariant {
  id            Int      @id @default(autoincrement())
  experimentId  Int
  variantKey    String
  payload       Json
  aiExplanation String?
  confidence    Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  experiment     ContentExperiment   @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  metrics        VariantMetric[]
  autoActions    AiAutoAction[]      @relation("VariantAutoActions")
  wonExperiments ContentExperiment[] @relation("ExperimentWinner")

  @@unique([experimentId, variantKey])
  @@index([experimentId])
}

model VariantMetric {
  id          Int      @id @default(autoincrement())
  variantId   Int
  impressions Int      @default(0)
  clicks      Int      @default(0)
  conversions Int      @default(0)
  dwellMs     Int      @default(0)
  ctr         Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  variant ContentVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId])
}

model AiAutoAction {
  id             Int              @id @default(autoincrement())
  organizationId String?
  actionType     AutoActionType
  contentId      Int?
  experimentId   Int?
  variantId      Int?
  reason         String?
  confidence     Float?
  status         AutoActionStatus @default(applied)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  experiment ContentExperiment? @relation("ExperimentAutoActions", fields: [experimentId], references: [id])
  variant    ContentVariant?    @relation("VariantAutoActions", fields: [variantId], references: [id])

  @@index([organizationId, actionType, createdAt])
}

model GlobalContentSignal {
  id             Int            @id @default(autoincrement())
  organizationId String?
  axis           ExperimentAxis
  window         String
  signal         Json
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([organizationId, axis, window], map: "organizationId_axis_window")
  @@index([organizationId, axis, window])
}

model Payment {
  id               String   @id @default(cuid())
  invoiceId        String
  attemptId        String?
  paidAmount       Int
  refundedAmount   Int      @default(0)
  paidCurrency     String   @default("IDR")
  paidAt           DateTime
  method           String?
  note             String?
  gatewayProvider  String?
  gatewayPaymentId String?
  gatewayStatus    String?
  gatewayMetadata  Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  invoice  Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  attempt  PaymentAttempt? @relation(fields: [attemptId], references: [id], onDelete: SetNull)
  receipts Receipt[]

  @@unique([gatewayProvider, gatewayPaymentId], map: "payment_gateway_provider_external_id")
  @@index([invoiceId])
  @@index([attemptId])
}

enum PaymentAttemptStatus {
  PENDING
  AUTHORIZED
  SETTLED
  EXPIRED
  CANCELLED
  FAILED
  REFUNDED
}

enum PaymentEventType {
  PENDING
  AUTHORIZED
  SETTLED
  EXPIRED
  CANCELLED
  FAILED
  REFUNDED
}

model PaymentAttempt {
  id                String               @id @default(cuid())
  invoiceId         String
  provider          String
  idempotencyKey    String
  providerOrderId   String?
  providerSessionId String?
  providerPaymentId String?
  providerToken     String?
  checkoutUrl       String?
  amount            Int
  currency          String
  status            PaymentAttemptStatus @default(PENDING)
  expiresAt         DateTime?
  metadata          Json?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  invoice  Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  events   PaymentEvent[]
  payments Payment[]

  @@unique([provider, idempotencyKey], map: "payment_attempt_provider_idempotency_key")
  @@unique([provider, providerOrderId], map: "payment_attempt_provider_order_id")
  @@index([invoiceId, provider, status])
  @@index([provider, providerSessionId])
}

model PaymentEvent {
  id              String               @id @default(cuid())
  attemptId       String
  provider        String
  providerEventId String
  eventType       PaymentEventType
  status          PaymentAttemptStatus
  amount          Int?
  currency        String?
  payload         Json?
  createdAt       DateTime             @default(now())

  attempt PaymentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@unique([provider, providerEventId], map: "payment_event_provider_event_id")
  @@index([attemptId, createdAt])
}

enum ReceiptPosition {
  bottom_left
  bottom_right
  center
}

model Receipt {
  id                      String          @id @default(cuid())
  paymentId               String
  receiptNo               String          @unique
  verifyToken             String          @db.VarChar(64)
  positionPreset          ReceiptPosition
  stampCompanySealEnabled Boolean         @default(false)
  stampPaidEnabled        Boolean         @default(true)
  signatureEnabled        Boolean         @default(false)
  createdAt               DateTime        @default(now())

  payment Payment           @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  audits  ReceiptAuditLog[]

  @@index([paymentId])
}

model ReceiptAuditLog {
  id        String   @id @default(cuid())
  receiptId String
  action    String
  actor     String
  meta      Json?
  createdAt DateTime @default(now())

  receipt Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@index([receiptId])
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String?
  userId    String?
  action    String
  entity    String
  entityId  String?
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([userId])
  @@index([action])
  @@index([entity, entityId])
  @@index([createdAt])
}

model Client {
  id             String   @id @default(cuid())
  userId         String
  organizationId String?
  name           String
  email          String?
  phone          String?
  address        String?
  company        String?
  taxId          String?
  currency       String   @default("IDR")
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization     Organization?     @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  invoices         Invoice[]
  invoiceTemplates InvoiceTemplate[]

  @@unique([userId, email], map: "client_user_email")
  @@unique([organizationId, email], map: "client_organization_email")
  @@index([userId])
  @@index([organizationId])
  @@index([organizationId, createdAt])
}

model InvoiceTemplate {
  id             String        @id @default(cuid())
  name           String
  client         String
  items          Json
  subtotal       Int
  tax            Int
  total          Int
  currency       String        @default("IDR")
  notes          String?
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  clientId       String?
  client_rel     Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([organizationId])
  @@index([clientId])
}

model FeatureFlag {
  id            String   @id @default(cuid())
  key           String   @unique
  name          String
  description   String?
  enabled       Boolean  @default(true)
  targetTenants Json?
  targetUsers   Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([key])
  @@index([enabled])
}

model UptimeCheck {
  id         String   @id @default(cuid())
  url        String
  name       String?
  statusCode Int
  latencyMs  Float
  status     String   @default("UP")
  error      String?
  createdAt  DateTime @default(now())

  @@index([url])
  @@index([status])
  @@index([createdAt])
}
