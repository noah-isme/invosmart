# InvoSmart environment reference
#
# This file is the canonical list of every environment variable the app reads.
# `npm run docs:env-check` (CI) fails when code reads a variable that is not
# listed here. Values below are safe placeholders; never commit real secrets.
#
# Lines starting with `# NAME=` are optional variables documented but unset.
# Test-only variables (E2E_*, PLAYWRIGHT_BASE_URL, INVOSMART_E2E_PROVIDER_BASE_URL)
# are documented in docs/E2E_TESTING.md and must never be set in a deployed
# environment. Deployment and per-environment notes: docs/DEPLOYMENT.md.

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Required. Public base URL of the app; also the NextAuth callback base.
NEXTAUTH_URL=http://localhost:1234
# Required. Session signing secret (`openssl rand -base64 32`). Also the
# fallback HMAC secret for public invoice links (see INVOICE_SHARE_SECRET).
NEXTAUTH_SECRET=replace_with_strong_secret
# Optional. Base URL used in emailed invoice/payment links and reminders.
# Falls back to NEXTAUTH_URL. Set it when the public URL differs from NEXTAUTH_URL.
# NEXT_PUBLIC_APP_URL=http://localhost:1234

# Platform administrators (DevTools, /app/admin global pages, global admin APIs).
# Comma-separated "User"."id" values (NOT emails): ADMIN_USER_IDS=cuid1,cuid2
# Empty = nobody is a platform admin outside `next dev`.
# Get your id by signing in and opening GET /api/auth/session (copy user.id).
# Do NOT look it up by email in the database: an unclaimed admin email could have
# been registered by someone else. See docs/WORKSPACE_RBAC.md for the deploy order.
# ADMIN_EMAILS / NEXT_PUBLIC_ADMIN_EMAILS are DEPRECATED and ignored (registration
# does not verify email ownership); remove them from deployed environments.
# The app only reads them to log a one-time warning when they are still set.
ADMIN_USER_IDS=
# ADMIN_EMAILS=
# NEXT_PUBLIC_ADMIN_EMAILS=

# Required in production. Bearer token for /api/cron/* (Vercel Cron sends it as
# `Authorization: Bearer <CRON_SECRET>`). Query-string secrets are rejected.
CRON_SECRET=replace_with_strong_cron_secret
# Optional separate HMAC secret for public invoice links. If omitted, NEXTAUTH_SECRET is used.
INVOICE_SHARE_SECRET=

# Release metadata shown in the UI and attached to Sentry events. Set by CI.
NEXT_PUBLIC_APP_VERSION=v1.0.0
NEXT_PUBLIC_BUILD_DATE=2025-01-01T00:00:00.000Z
NEXT_PUBLIC_COMMIT_SHA=local

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Required. PostgreSQL primary data store (see docs/DATABASE.md).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/invosmart?schema=public"

# ---------------------------------------------------------------------------
# Workspaces / team operations
# ---------------------------------------------------------------------------
# Required for Slack reminder endpoints. Base64 or 64-character hex encoding of
# 32 random bytes (`openssl rand -base64 32`).
WORKSPACE_NOTIFICATION_ENCRYPTION_KEY=
# `compat` (default) or `enforce`. Use compat during additive migration rehearsal;
# switch to enforce only after personal-workspace backfill and orphan checks pass
# in staging. See docs/WORKSPACE_RBAC.md.
WORKSPACE_AUTH_MODE=compat

# ---------------------------------------------------------------------------
# Auth providers
# ---------------------------------------------------------------------------
# Optional. Google OAuth; both must be set to enable "Sign in with Google".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Payments (docs/INTEGRATIONS.md)
# ---------------------------------------------------------------------------
# Required in staging/production (checked by `npm run release:certify`).
# Use sandbox/test keys everywhere except production.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Not read by app code today; required by release certification and staging CI.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

MIDTRANS_SERVER_KEY=SB-Mid-server-...
MIDTRANS_CLIENT_KEY=SB-Mid-client-...
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-...

# ---------------------------------------------------------------------------
# Email (Resend)
# ---------------------------------------------------------------------------
# Required in staging/production for invoice delivery and reminders.
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=invoices@yourdomain.com
# Svix signing secret for POST /api/webhooks/resend.
RESEND_WEBHOOK_SECRET=whsec_...

# ---------------------------------------------------------------------------
# Redis (Upstash)
# ---------------------------------------------------------------------------
# Optional but recommended in production. Used for /api/v1 rate limits and
# idempotency keys and for the AI orchestrator event stream. Without it both
# fall back to process-local memory (not shared across serverless instances).
# The Vercel KV names (KV_REST_API_*) are accepted as an alias by /api/v1.
# UPSTASH_REDIS_REST_URL=https://<your-db>.upstash.io
# UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
# Telemetry toggles (default true). Set both to false to disable PostHog/Sentry capture.
ENABLE_TELEMETRY=true
NEXT_PUBLIC_ENABLE_TELEMETRY=true

# PostHog product analytics.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
# Server-side PostHog query API, read by the AI optimizer (lib/ai/optimizer.ts).
# The optimizer skips PostHog metrics unless POSTHOG_API_KEY and POSTHOG_PROJECT_ID are set.
POSTHOG_API_KEY=
# POSTHOG_PROJECT_ID=
# POSTHOG_API_HOST=https://app.posthog.com

# Sentry error tracking.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENV=development
# Optional. Server-side Sentry environment name; defaults to NODE_ENV.
# SENTRY_ENV=production
# Optional. Sentry API access for the AI optimizer's metrics collection; skipped
# unless all three are set. Use a read-only internal-integration token.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG_SLUG=
# SENTRY_PROJECT_SLUG=

# Optional. Real-user-monitoring sample rate for performance tools, 0..1 (default 0.2).
# NEXT_PUBLIC_RUM_SAMPLE_RATE=0.2

# Optional. Comma-separated URLs checked by /api/cron/uptime. Absolute URLs are
# used as is; app-relative paths resolve against NEXT_PUBLIC_APP_URL, then
# NEXTAUTH_URL, then https://$VERCEL_URL (the deployed host). Default when
# unset: /api/health?db=1 on the deployed host (health check with a DB ping).
# UPTIME_MONITORED_ENDPOINTS=/api/health?db=1

# ---------------------------------------------------------------------------
# AI providers
# ---------------------------------------------------------------------------
# At least one is needed for AI features. Gemini is preferred when
# GEMINI_API_KEY is set; otherwise OpenAI is used (lib/ai.ts, ADR 012).
# Both keys set = failover: a timeout, network error or HTTP 408/429/5xx from
# the primary is retried once on the other provider.
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional. Per-request timeout for each AI provider call, in milliseconds
# (default 20000). A failover can take up to twice this value.
# AI_REQUEST_TIMEOUT_MS=20000

# ---------------------------------------------------------------------------
# AI agents (docs/ai/)
# ---------------------------------------------------------------------------
# Agent toggles. Each is ON unless set to the string "false".
# ENABLE_AI_OPTIMIZER=true
# ENABLE_AI_LEARNING=true
# ENABLE_AI_GOVERNANCE=true
# ENABLE_AI_AUTONOMY=true
# ENABLE_AI_FEDERATION=true
# Optional overrides for the content optimizer APIs (/api/opt/*); fall back to
# ENABLE_AI_OPTIMIZER when unset.
# ENABLE_AI_OPTIMIZER_LOCAL=true
# ENABLE_AI_OPTIMIZER_GLOBAL=true
# Client-side optimizer UI toggle: "true" / "false"; unset follows the server default.
# NEXT_PUBLIC_ENABLE_AI_OPTIMIZER=true
# Set to "memory" to force the in-process orchestrator stream even when Upstash is configured.
# ENABLE_AI_ORCHESTRATION=memory
# Max AI auto-publish actions per tenant per day (default 2).
# AI_SA_MAX_AUTOPUBLISH_PER_DAY=2

# Optional. Webhook alerts for AI auto-actions (AUTOPUBLISH, SCHEDULE_UPDATE,
# AUTO_REVERT). SLACK_WEBHOOK_URL is also the default for lib/team/slack.ts when a
# caller passes no webhook URL; workspace reminders use their own encrypted endpoint.
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# ---------------------------------------------------------------------------
# Federation (docs/ai/federation.md)
# ---------------------------------------------------------------------------
# Shared secret for signed FDP events and peer bearer auth on /api/federation/status.
# If unset, the status endpoint only accepts platform-admin sessions.
FEDERATION_TOKEN_SECRET=
# Optional. This deployment's tenant id on the federation bus (default "local").
# FEDERATION_TENANT_ID=
# Optional. Comma-separated peer endpoints that receive federation events.
# FEDERATION_ENDPOINTS=https://peer-a.example.com/federation,https://peer-b.example.com/federation
# Optional. PEM-encoded RSA key pair and key id for asymmetric signing and
# hybrid payload encryption. Without a private key the bus signs with HMAC-SHA256
# using FEDERATION_TOKEN_SECRET.
# FEDERATION_PRIVATE_KEY=
# FEDERATION_PUBLIC_KEY=
# FEDERATION_KEY_ID=

# ---------------------------------------------------------------------------
# Receipts
# ---------------------------------------------------------------------------
# Optional. Default stamp position: bottom-right (default) or bottom-left.
# RECEIPT_DEFAULT_POSITION=bottom-right
# Optional. Comma-separated allowed stamp positions.
# RECEIPT_ALLOWED_POSITIONS=bottom-left,bottom-right,center

# ---------------------------------------------------------------------------
# CI-only (GitHub Actions secrets; never read by the app)
# ---------------------------------------------------------------------------
# VERCEL_TOKEN: used by .github/workflows/release.yml to run `vercel deploy --prod`.
# STAGING_*: staging certification secrets; see docs/runbooks/release-certification.md.
